datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ItemType {
  BILL
  SUBSCRIPTION
  DOCUMENT
  APPOINTMENT
  TASK
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ItemStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model User {
  id            String              @id @default(uuid())
  email         String              @unique
  passwordHash  String
  name          String
  timezone      String              @default("UTC")
  currency      String              @default("USD")
  startOfWeek   String              @default("monday")
  dateFormat    String              @default("MM/DD/YYYY")
  resetToken    String?
  resetTokenExpiry DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  items         Item[]
  categories    Category[]
  activities    Activity[]
  notifications InAppNotification[]
}

model Category {
  id        String   @id @default(uuid())
  userId    String?  // null for default system categories
  name      String
  color     String   @default("#6366f1")
  icon      String   @default("folder")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Item[]
  createdAt DateTime @default(now())

  @@unique([userId, name])
}

model Item {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  type               ItemType     @default(TASK)
  status             ItemStatus   @default(PENDING)
  priority           Priority     @default(MEDIUM)
  categoryId         String?
  category           Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  dueDate            DateTime
  hasSpecificTime    Boolean      @default(false)
  amount             Decimal?     @db.Decimal(12, 2)
  currency           String       @default("USD")

  documentNumber     String?
  issuingAuthority   String?

  recurrence         Recurrence   @default(NONE)
  reminderDaysBefore Int[]        @default([1, 3])

  completedAt        DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  attachments        Attachment[]
  reminders          Reminder[]
  activities         Activity[]

  @@index([userId, status, dueDate])
}

model Attachment {
  id        String   @id @default(uuid())
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  fileSize  Int
  mimeType  String
  createdAt DateTime @default(now())

  @@index([itemId])
}

model Reminder {
  id          String   @id @default(uuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  isTriggered Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([remindAt, isTriggered])
}

model InAppNotification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  itemId    String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
